<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Aemeath reference UI: soft pink desktop-pet panels with light cards and subtle pixel accents. -->
    <FontFamily x:Key="AemiPixelFontFamily">avares://Aemeath-agent/Assets/fonts/zpix.ttf#Zpix</FontFamily>
    <FontFamily x:Key="AemiBodyFontFamily">Microsoft YaHei UI, Segoe UI, Inter</FontFamily>

    <Color x:Key="AemiVoidColor">#FFF1F6</Color>
    <Color x:Key="AemiVoidDeepColor">#FFE1EE</Color>
    <Color x:Key="AemiNebulaColor">#FFF1F6</Color>
    <Color x:Key="AemiPanelColor">#FFFFFF</Color>
    <Color x:Key="AemiPanelSoftColor">#FFF8FB</Color>
    <Color x:Key="AemiPanelRaisedColor">#FFFFFF</Color>
    <Color x:Key="AemiGlassColor">#FFFFFFFF</Color>
    <Color x:Key="AemiGlassSoftColor">#FFFFF8FB</Color>
    <Color x:Key="AemiArchiveColor">#FFF8FB</Color>

    <Color x:Key="AemiPinkColor">#FF69B4</Color>
    <Color x:Key="AemiPinkSoftColor">#FFD1E5</Color>
    <Color x:Key="AemiPinkDeepColor">#E84D8E</Color>
    <Color x:Key="AemiHaloColor">#FF9BCF</Color>
    <Color x:Key="AemiHaloSoftColor">#FFE1EE</Color>
    <Color x:Key="AemiHaloDeepColor">#E84D8E</Color>
    <Color x:Key="AemiStarColor">#FF69B4</Color>
    <Color x:Key="AemiGhostColor">#FFFFFF</Color>

    <Color x:Key="AemiBorderColor">#F3C2D4</Color>
    <Color x:Key="AemiBorderSoftColor">#F8D8E4</Color>
    <Color x:Key="AemiBorderGlowColor">#FF69B4</Color>
    <Color x:Key="AemiFocusColor">#E84D8E</Color>

    <Color x:Key="AemiTextPrimaryColor">#4A2A3A</Color>
    <Color x:Key="AemiTextSecondaryColor">#7A5564</Color>
    <Color x:Key="AemiTextMutedColor">#80606E</Color>
    <Color x:Key="AemiTextFaintColor">#80606E</Color>
    <Color x:Key="AemiPrimaryForegroundColor">#07101E</Color>
    <Color x:Key="AemiIconColor">#7A3156</Color>
    <Color x:Key="AemiSuccessColor">#1F7A4D</Color>
    <Color x:Key="AemiWarningColor">#8A5300</Color>
    <Color x:Key="AemiErrorColor">#B52E49</Color>
    <Color x:Key="AemiDisabledColor">#C9A7B5</Color>
    <Color x:Key="AemiSuccessSurfaceColor">#E9FFF2</Color>
    <Color x:Key="AemiSuccessBorderColor">#9BD4B2</Color>
    <Color x:Key="AemiWarningSurfaceColor">#FFF3E0</Color>
    <Color x:Key="AemiWarningBorderColor">#E5C08D</Color>
    <Color x:Key="AemiErrorSurfaceColor">#FFEAF0</Color>
    <Color x:Key="AemiErrorBorderColor">#E8A8B6</Color>
    <Color x:Key="AemiInfoSurfaceColor">#EEF3FF</Color>
    <Color x:Key="AemiInfoForegroundColor">#3A5A8C</Color>
    <Color x:Key="AemiCodeSurfaceColor">#FFF4F8</Color>
    <Color x:Key="AemiAmbientPinkStartColor">#55FFD1E5</Color>
    <Color x:Key="AemiAmbientPinkEndColor">#00FFD1E5</Color>
    <Color x:Key="AemiAmbientHaloStartColor">#55FFE1EE</Color>
    <Color x:Key="AemiAmbientHaloEndColor">#00FFE1EE</Color>
    <Color x:Key="AemiAmbientWhiteStartColor">#33FFFFFF</Color>
    <Color x:Key="AemiAmbientWhiteEndColor">#00FFFFFF</Color>

    <Color x:Key="AemiInkColor">#4A2A3A</Color>
    <Color x:Key="AemiBorderStrongColor">#FF69B4</Color>
    <Color x:Key="AemiBlueColor">#FF9BCF</Color>
    <Color x:Key="AemiBlueLightColor">#FFE1EE</Color>
    <Color x:Key="AemiBlueDarkColor">#E84D8E</Color>
    <Color x:Key="AemiGoldColor">#FF69B4</Color>
    <Color x:Key="AemiAccentColor">#FF69B4</Color>
    <Color x:Key="AemiBackgroundColor">#FFF1F6</Color>
    <Color x:Key="AemiBackgroundDarkColor">#FFE1EE</Color>
    <Color x:Key="AemiSurfaceColor">#FFFFFF</Color>
    <Color x:Key="AemiGradientStartColor">#FF69B4</Color>
    <Color x:Key="AemiGradientEndColor">#FFD1E5</Color>

    <SolidColorBrush x:Key="AemiVoidBrush" Color="{StaticResource AemiVoidColor}"/>
    <SolidColorBrush x:Key="AemiVoidDeepBrush" Color="{StaticResource AemiVoidDeepColor}"/>
    <SolidColorBrush x:Key="AemiNebulaBrush" Color="{StaticResource AemiNebulaColor}"/>
    <SolidColorBrush x:Key="AemiPanelBrush" Color="{StaticResource AemiPanelColor}"/>
    <SolidColorBrush x:Key="AemiPanelSoftBrush" Color="{StaticResource AemiPanelSoftColor}"/>
    <SolidColorBrush x:Key="AemiPanelRaisedBrush" Color="{StaticResource AemiPanelRaisedColor}"/>
    <SolidColorBrush x:Key="AemiGlassBrush" Color="{StaticResource AemiGlassColor}"/>
    <SolidColorBrush x:Key="AemiGlassSoftBrush" Color="{StaticResource AemiGlassSoftColor}"/>
    <SolidColorBrush x:Key="AemiArchiveBrush" Color="{StaticResource AemiArchiveColor}"/>

    <SolidColorBrush x:Key="AemiPinkBrush" Color="{StaticResource AemiPinkColor}"/>
    <SolidColorBrush x:Key="AemiPinkSoftBrush" Color="{StaticResource AemiPinkSoftColor}"/>
    <SolidColorBrush x:Key="AemiPinkDeepBrush" Color="{StaticResource AemiPinkDeepColor}"/>
    <SolidColorBrush x:Key="AemiHaloBrush" Color="{StaticResource AemiHaloColor}"/>
    <SolidColorBrush x:Key="AemiHaloSoftBrush" Color="{StaticResource AemiHaloSoftColor}"/>
    <SolidColorBrush x:Key="AemiHaloDeepBrush" Color="{StaticResource AemiHaloDeepColor}"/>
    <SolidColorBrush x:Key="AemiStarBrush" Color="{StaticResource AemiStarColor}"/>
    <SolidColorBrush x:Key="AemiGhostBrush" Color="{StaticResource AemiGhostColor}"/>

    <SolidColorBrush x:Key="AemiBorderBrush" Color="{StaticResource AemiBorderColor}"/>
    <SolidColorBrush x:Key="AemiBorderSoftBrush" Color="{StaticResource AemiBorderSoftColor}"/>
    <SolidColorBrush x:Key="AemiBorderStrongBrush" Color="{StaticResource AemiBorderGlowColor}"/>
    <SolidColorBrush x:Key="AemiBorderGlowBrush" Color="{StaticResource AemiBorderGlowColor}"/>
    <SolidColorBrush x:Key="AemiFocusBrush" Color="{StaticResource AemiFocusColor}"/>

    <SolidColorBrush x:Key="AemiTextPrimaryBrush" Color="{StaticResource AemiTextPrimaryColor}"/>
    <SolidColorBrush x:Key="AemiTextSecondaryBrush" Color="{StaticResource AemiTextSecondaryColor}"/>
    <SolidColorBrush x:Key="AemiTextMutedBrush" Color="{StaticResource AemiTextMutedColor}"/>
    <SolidColorBrush x:Key="AemiTextFaintBrush" Color="{StaticResource AemiTextFaintColor}"/>
    <SolidColorBrush x:Key="AemiSuccessBrush" Color="{StaticResource AemiSuccessColor}"/>
    <SolidColorBrush x:Key="AemiWarningBrush" Color="{StaticResource AemiWarningColor}"/>
    <SolidColorBrush x:Key="AemiErrorBrush" Color="{StaticResource AemiErrorColor}"/>
    <SolidColorBrush x:Key="AemiDisabledBrush" Color="{StaticResource AemiDisabledColor}"/>
    <SolidColorBrush x:Key="AemiSuccessSurfaceBrush" Color="{StaticResource AemiSuccessSurfaceColor}"/>
    <SolidColorBrush x:Key="AemiSuccessBorderBrush" Color="{StaticResource AemiSuccessBorderColor}"/>
    <SolidColorBrush x:Key="AemiWarningSurfaceBrush" Color="{StaticResource AemiWarningSurfaceColor}"/>
    <SolidColorBrush x:Key="AemiWarningBorderBrush" Color="{StaticResource AemiWarningBorderColor}"/>
    <SolidColorBrush x:Key="AemiErrorSurfaceBrush" Color="{StaticResource AemiErrorSurfaceColor}"/>
    <SolidColorBrush x:Key="AemiErrorBorderBrush" Color="{StaticResource AemiErrorBorderColor}"/>
    <SolidColorBrush x:Key="AemiInfoSurfaceBrush" Color="{StaticResource AemiInfoSurfaceColor}"/>
    <SolidColorBrush x:Key="AemiInfoForegroundBrush" Color="{StaticResource AemiInfoForegroundColor}"/>
    <SolidColorBrush x:Key="AemiCodeSurfaceBrush" Color="{StaticResource AemiCodeSurfaceColor}"/>

    <SolidColorBrush x:Key="AemiPrimaryForegroundBrush" Color="{StaticResource AemiPrimaryForegroundColor}"/>
    <SolidColorBrush x:Key="AemiIconBrush" Color="{StaticResource AemiIconColor}"/>
    <SolidColorBrush x:Key="AemiInkBrush" Color="{StaticResource AemiInkColor}"/>
    <SolidColorBrush x:Key="AemiBlueBrush" Color="{StaticResource AemiBlueColor}"/>
    <SolidColorBrush x:Key="AemiBlueLightBrush" Color="{StaticResource AemiBlueLightColor}"/>
    <SolidColorBrush x:Key="AemiBlueDarkBrush" Color="{StaticResource AemiBlueDarkColor}"/>
    <SolidColorBrush x:Key="AemiGoldBrush" Color="{StaticResource AemiGoldColor}"/>
    <SolidColorBrush x:Key="AemiAccentBrush" Color="{StaticResource AemiAccentColor}"/>
    <SolidColorBrush x:Key="AemiBackgroundBrush" Color="{StaticResource AemiBackgroundColor}"/>
    <SolidColorBrush x:Key="AemiBackgroundDarkBrush" Color="{StaticResource AemiBackgroundDarkColor}"/>
    <SolidColorBrush x:Key="AemiSurfaceBrush" Color="{StaticResource AemiSurfaceColor}"/>

    <RadialGradientBrush x:Key="AemiWindowBackgroundBrush" Center="51%,36%" GradientOrigin="51%,36%" RadiusX="1.04" RadiusY="1.04">
        <GradientStop Color="{StaticResource AemiVoidColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AemiPanelSoftColor}" Offset="0.59"/>
        <GradientStop Color="{StaticResource AemiVoidDeepColor}" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AemiGlowPinkBrush" Center="12%,20%" RadiusX="58%" RadiusY="58%">
        <GradientStop Color="{StaticResource AemiAmbientPinkStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AemiAmbientPinkEndColor}" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AemiGlowHaloBrush" Center="89%,70%" RadiusX="62%" RadiusY="62%">
        <GradientStop Color="{StaticResource AemiAmbientHaloStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AemiAmbientHaloEndColor}" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AemiGlowWhiteBrush" Center="51%,5%" RadiusX="74%" RadiusY="42%">
        <GradientStop Color="{StaticResource AemiAmbientWhiteStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AemiAmbientWhiteEndColor}" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="AemiPrimaryGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource AemiPinkColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AemiPinkDeepColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AemiArchiveGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource AemiPanelColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AemiPanelSoftColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AemiGhostGradientBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="{StaticResource AemiPanelSoftColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AemiHaloSoftColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AemiPinkGradientBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="{StaticResource AemiPinkColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AemiPinkDeepColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AemiBlueGradientBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="{StaticResource AemiHaloSoftColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AemiPinkSoftColor}" Offset="1.0"/>
    </LinearGradientBrush>

    <x:Double x:Key="AemiSpace1">4</x:Double>
    <x:Double x:Key="AemiSpace2">8</x:Double>
    <x:Double x:Key="AemiSpace3">12</x:Double>
    <x:Double x:Key="AemiSpace4">16</x:Double>
    <x:Double x:Key="AemiSpace5">20</x:Double>
    <x:Double x:Key="AemiSpace6">24</x:Double>

    <x:Double x:Key="AemiFontSizeSmall">12</x:Double>
    <x:Double x:Key="AemiFontSizeNormal">14</x:Double>
    <x:Double x:Key="AemiFontSizeMedium">16</x:Double>
    <x:Double x:Key="AemiFontSizeLarge">20</x:Double>
    <x:Double x:Key="AemiFontSizeXLarge">24</x:Double>
    <x:Double x:Key="AemiFontSizeTitle">28</x:Double>

    <CornerRadius x:Key="AemiCornerRadiusTiny">3</CornerRadius>
    <CornerRadius x:Key="AemiCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="AemiCornerRadiusNormal">6</CornerRadius>
    <CornerRadius x:Key="AemiCornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="AemiCornerRadiusLarge">10</CornerRadius>
    <CornerRadius x:Key="AemiCornerRadiusXLarge">12</CornerRadius>

    <Thickness x:Key="AemiWindowPadding">20</Thickness>
    <Thickness x:Key="AemiPanelPadding">16</Thickness>
    <Thickness x:Key="AemiFieldPadding">10,7</Thickness>

</ResourceDictionary>

