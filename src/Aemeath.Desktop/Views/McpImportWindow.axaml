<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Aemeath.Desktop.Views"
        x:Class="Aemeath.Desktop.Views.McpImportWindow"
        Title="从 JSON 导入 MCP 服务"
        Width="580" Height="480" MinWidth="440" MinHeight="360"
        CanResize="True" ShowInTaskbar="False" WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*">
    <views:AemeathTitleBar Grid.Row="0"
                             Title="&#x4ECE; JSON &#x5BFC;&#x5165; MCP &#x670D;&#x52A1;"
                             ShowMinimizeButton="False"
                             ShowMaximizeButton="False"/>
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="从 JSON 导入" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="粘贴标准 mcpServers 配置。导入会立即写入本地服务目录。" Classes="muted" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Classes="card" Padding="8">
      <TextBox x:Name="JsonBox" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="Cascadia Code,Consolas,Courier New" FontSize="13"
               PlaceholderText="粘贴包含 mcpServers 的 JSON 配置"
               AutomationProperties.Name="MCP JSON 配置"/>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource AemiErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" Content="取消" Classes="ghost" MinWidth="88" Click="CancelButton_Click"/>
        <Button x:Name="ConfirmButton" Content="导入" Classes="primary" MinWidth="88" Click="ConfirmButton_Click"/>
      </StackPanel>
    </Grid>
    </Grid>
  </Grid>
</Window>
