<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aemeath.Desktop.Views.McpConfigWindow"
        Width="590" Height="460"
        MinWidth="500" MinHeight="380"
        Title="MCP 配置"
        Icon="avares://Aemeath-agent/Assets/static/app.ico">
  <Window.Styles>
    <Style Selector="TextBlock.subtle">
      <Setter Property="Foreground" Value="{StaticResource AemiTextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource AemiTextMutedBrush}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#24304C"/>
      <Setter Property="Foreground" Value="{StaticResource AemiTextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AemiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#2E3C60"/>
      <Setter Property="BorderBrush" Value="{StaticResource AemiBorderStrongBrush}"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#161F36"/>
      <Setter Property="BorderBrush" Value="{StaticResource AemiBorderSoftBrush}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#172238"/>
      <Setter Property="Foreground" Value="{StaticResource AemiTextPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AemiFocusBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AemiBorderBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,9"/>
    </Style>
  </Window.Styles>
  <Grid>
    <Grid.Background>
      <RadialGradientBrush Center="50%,24%" GradientOrigin="50%,24%" RadiusX="1" RadiusY="1">
        <GradientStop Color="#141F39" Offset="0.0"/>
        <GradientStop Color="#07101E" Offset="0.68"/>
        <GradientStop Color="#02040A" Offset="1.0"/>
      </RadialGradientBrush>
    </Grid.Background>

    <Border Margin="18" CornerRadius="20" Background="{StaticResource AemiGlassBrush}" BorderBrush="#6673C7FF" BorderThickness="1" Padding="18">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Schema 草稿舱" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}"/>
            <Border CornerRadius="999" Padding="8,3" Background="#2473C7FF" BorderBrush="#6673C7FF" BorderThickness="1">
              <TextBlock Text="MCP Draft" FontSize="12" Foreground="{StaticResource AemiHaloSoftBrush}" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock Text="为小爱的本地工具链整理工具名与参数 Schema。" Classes="subtle" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,14,0,0">
          <TextBlock Text="工具名称" Classes="subtle"/>
          <TextBox x:Name="ToolNameBox" Watermark="browser.search"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="参数 Schema (JSON)" Classes="subtle" Margin="0,14,0,0"/>
        <TextBox x:Name="SchemaBox"
                 Grid.Row="3"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Background="#141F35"
                 BorderBrush="{StaticResource AemiBorderBrush}"
                 Margin="0,6,0,0"/>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
          <TextBlock Text="当前执行能力由 MCP 插件决定" Classes="muted" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="CloseButton" Content="关闭" Classes="ghost" MinWidth="88"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
