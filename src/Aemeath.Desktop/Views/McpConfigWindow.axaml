<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aemeath.Desktop.Views.McpConfigWindow"
        Width="900" Height="680"
        MinWidth="720" MinHeight="560"
        Title="MCP 配置"
        Icon="avares://Aemeath-agent/Assets/static/app.ico">
  <Window.Styles>
    <Style Selector="TextBlock.subtle">
      <Setter Property="Foreground" Value="{StaticResource AemiTextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource AemiTextMutedBrush}"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#FFE1EE"/>
      <Setter Property="BorderBrush" Value="{StaticResource AemiBorderSoftBrush}"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FFEAF0"/>
      <Setter Property="BorderBrush" Value="#F0A9B8"/>
      <Setter Property="Foreground" Value="#D94A62"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource AemiTextPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AemiFocusBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AemiBorderBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource AemiTextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AemiBorderBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
  </Window.Styles>

  <Grid Background="#FFF1F6">
    <Border Margin="18" CornerRadius="20" Background="{StaticResource AemiGlassBrush}" BorderBrush="#F3C2D4" BorderThickness="1" Padding="18">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="MCP 服务管理" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}"/>
            <TextBlock Text="导入、测试并启用 stdio / SSE / HTTP MCP 服务。" Classes="subtle" FontSize="13"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="CloseButton" Content="关闭" Classes="ghost" MinWidth="88"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="280,*" Margin="0,16,0,0">
          <Border CornerRadius="14" Background="#FFFFFF" BorderBrush="#F3C2D4" BorderThickness="1" Padding="12">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="服务列表" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="NewServerButton" Content="新增" Classes="ghost" MinWidth="66"/>
              </Grid>
              <ListBox Grid.Row="1" x:Name="ServerListBox" Margin="0,12,0,0"/>
              <TextBlock Grid.Row="2" x:Name="StatusText" Text="尚未选择服务" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
          </Border>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="16,0,0,0">
            <Border CornerRadius="14" Background="#FFFFFF" BorderBrush="#F3C2D4" BorderThickness="1" Padding="14">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*">
                <CheckBox Grid.Row="0" x:Name="EnabledBox" Content="启用此服务" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6" Margin="0,12,8,0">
                  <TextBlock Text="服务 ID" Classes="subtle"/>
                  <TextBox x:Name="ServerIdBox" Watermark="filesystem"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" Margin="8,12,0,0">
                  <TextBlock Text="显示名称" Classes="subtle"/>
                  <TextBox x:Name="ServerNameBox" Watermark="Filesystem"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6" Margin="0,12,8,0">
                  <TextBlock Text="连接方式" Classes="subtle"/>
                  <ComboBox x:Name="TransportBox"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6" Margin="8,12,0,0">
                  <TextBlock Text="URL（SSE / HTTP）" Classes="subtle"/>
                  <TextBox x:Name="UrlBox" Watermark="https://example.com/mcp"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Spacing="6" Margin="0,12,8,0">
                  <TextBlock Text="Command（stdio）" Classes="subtle"/>
                  <TextBox x:Name="CommandBox" Watermark="bun / uvx / npx"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6" Margin="8,12,0,0">
                  <TextBlock Text="Args（每行一个）" Classes="subtle"/>
                  <TextBox x:Name="ArgsBox" AcceptsReturn="True" MinHeight="74" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="6" Margin="0,12,0,0">
                  <TextBlock Text="工作目录（stdio，可空）" Classes="subtle"/>
                  <TextBox x:Name="WorkingDirectoryBox" Watermark="C:\path\to\project"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="0" Spacing="6" Margin="0,12,8,0">
                  <TextBlock Text="Env（KEY=VALUE，每行一个）" Classes="subtle"/>
                  <TextBox x:Name="EnvBox" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Spacing="6" Margin="8,12,0,0">
                  <TextBlock Text="Headers（KEY=VALUE，每行一个）" Classes="subtle"/>
                  <TextBox x:Name="HeadersBox" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1" CornerRadius="14" Background="#FFFFFF" BorderBrush="#F3C2D4" BorderThickness="1" Padding="14" Margin="0,12,0,0">
              <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                <TextBlock Text="快速导入 JSON" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}"/>
                <Button Grid.Column="1" x:Name="ImportJsonButton" Content="导入" Classes="ghost" MinWidth="78"/>
                <TextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="ImportJsonBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Margin="0,10,0,0" Watermark="粘贴 { &quot;mcpServers&quot;: { ... } } 或单服务 JSON"/>
              </Grid>
            </Border>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,12,0,0">
              <Button x:Name="TestButton" Content="测试连接" Classes="ghost" MinWidth="96" Margin="0,0,8,0"/>
              <Button x:Name="SaveButton" Content="保存服务" Classes="primary" MinWidth="96" Margin="0,0,8,0"/>
              <Button x:Name="DeleteButton" Content="删除服务" Classes="danger" MinWidth="96"/>
            </WrapPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
