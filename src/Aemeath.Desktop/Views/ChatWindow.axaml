<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:Aemeath.Pet.Effects;assembly=Aemeath.Pet"
        xmlns:views="clr-namespace:Aemeath.Desktop.Views"
        xmlns:i="using:Avalonia.Input"
        x:Class="Aemeath.Desktop.Views.ChatWindow"
        Width="1040" Height="800"
        MinWidth="720" MinHeight="620"
        Title="&#x5C0F;&#x7231;&#x5BF9;&#x8BDD;"
        WindowDecorations="BorderOnly"
        Icon="avares://Aemeath-agent/Assets/static/app.ico">

  <Grid RowDefinitions="Auto,*">
    <Grid x:Name="BackgroundContainer" Grid.RowSpan="2" IsHitTestVisible="False" Background="{StaticResource AemiWindowBackgroundBrush}">
      <effects:ParticleField x:Name="BackgroundParticleCanvas" Opacity="0.28"/>
      <Border x:Name="GlowLayerPink" IsHitTestVisible="False" Background="{StaticResource AemiGlowPinkBrush}"/>
      <Border x:Name="GlowLayerBlue" IsHitTestVisible="False" Background="{StaticResource AemiGlowHaloBrush}"/>
      <Border x:Name="GlowLayerWhite" IsHitTestVisible="False" Opacity="0.52" Background="{StaticResource AemiGlowWhiteBrush}"/>
    </Grid>

    <views:AemeathTitleBar Grid.Row="0" Title="&#x7231;&#x5F25;&#x65AF;&#x52A9;&#x624B; &#x00B7; &#x5BF9;&#x8BDD;"/>

    <SplitView Grid.Row="1" x:Name="ChatSplitView"
               Margin="16"
               PaneBackground="Transparent"
               DisplayMode="Inline"
               PanePlacement="Left"
               OpenPaneLength="252"
               CompactPaneLength="0"
               IsPaneOpen="True">
      <SplitView.Pane>
        <Border x:Name="SessionSidebarCard" Margin="0,0,12,0" Classes="card" Padding="12">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="&#x901A;&#x8BAF;&#x6863;&#x6848;" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="SessionCountText" Text="" Classes="muted" FontSize="12"/>
              </StackPanel>
              <Button Grid.Column="1"
                      x:Name="CloseSidebarButton"
                      Content="&#x2039;"
                      Classes="ghost icon"
                      Width="42"
                      Height="42"
                      AutomationProperties.Name="&#x6536;&#x8D77;&#x4F1A;&#x8BDD;&#x4FA7;&#x680F;"/>
            </Grid>

            <TextBox Grid.Row="1"
                     x:Name="SessionSearchBox"
                     Margin="0,12,0,10"
                     PlaceholderText="&#x641C;&#x7D22;&#x5BF9;&#x8BDD;"
                     AutomationProperties.Name="&#x641C;&#x7D22;&#x5386;&#x53F2;&#x5BF9;&#x8BDD;"/>

            <ListBox Grid.Row="2"
                     x:Name="SessionListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     AutomationProperties.Name="&#x5386;&#x53F2;&#x5BF9;&#x8BDD;&#x5217;&#x8868;"/>

            <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,10,0,0">
              <Button x:Name="NewSessionButton" Content="&#x65B0;&#x5EFA;" Classes="primary compact" MinWidth="0"/>
              <Button Grid.Column="1"
                      x:Name="RenameSessionButton"
                      Content="&#x91CD;&#x547D;&#x540D;"
                      Classes="ghost compact"
                      MinWidth="0"
                      AutomationProperties.Name="&#x91CD;&#x547D;&#x540D;&#x5F53;&#x524D;&#x5BF9;&#x8BDD;"/>
              <Button Grid.Column="2" x:Name="DeleteSessionButton" Content="&#x5220;&#x9664;" Classes="danger compact" MinWidth="0"/>
            </Grid>
          </Grid>
        </Border>
      </SplitView.Pane>

      <SplitView.Content>
        <Grid x:Name="ChatMainLayout" RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Classes="card" Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto">
              <Border Width="54" Height="54" CornerRadius="27" BorderBrush="{StaticResource AemiPinkBrush}" BorderThickness="1.5" Background="White">
                <Image Source="avares://Aemeath-agent/Assets/static/xiaoai-avatar.png" Stretch="UniformToFill" ClipToBounds="True"/>
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="12,0,0,0">
                <TextBlock Text="&#x7231;&#x5F25;&#x65AF;" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="&#x98DE;&#x884C;&#x96EA;&#x7ED2;&#x9891;&#x9053; &#x00B7; &#x672C;&#x5730;&#x7EC8;&#x7AEF;" Classes="subtle" FontSize="12"/>
              </StackPanel>

              <Button Grid.Column="2"
                      x:Name="ToggleSidebarButton"
                      Content="&#x4F1A;&#x8BDD;"
                      Classes="ghost"
                      MinWidth="76"
                      AutomationProperties.Name="&#x6253;&#x5F00;&#x6216;&#x6536;&#x8D77;&#x4F1A;&#x8BDD;&#x4FA7;&#x680F;"/>
              <Button Grid.Column="3"
                      x:Name="OpenSettingsButton"
                      Content="&#x8BBE;&#x7F6E;"
                      Classes="ghost"
                      MinWidth="76"
                      Margin="8,0,0,0"
                      AutomationProperties.Name="&#x6253;&#x5F00;&#x8BBE;&#x7F6E;&#x4E2D;&#x5FC3;"/>

              <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnDefinitions="*,*" Margin="0,12,0,0">
                <ComboBox x:Name="ProviderQuickSwitchBox"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Provider"
                          AutomationProperties.Name="&#x5F53;&#x524D; Provider"/>
                <ComboBox Grid.Column="1"
                          x:Name="ModelQuickSwitchBox"
                          HorizontalAlignment="Stretch"
                          Margin="8,0,0,0"
                          PlaceholderText="&#x6A21;&#x578B;"
                          AutomationProperties.Name="&#x5F53;&#x524D;&#x6A21;&#x578B;"/>
              </Grid>

              <Border Grid.Row="2"
                      Grid.ColumnSpan="4"
                      x:Name="ProviderSwitchStatusBorder"
                      Classes="status"
                      Margin="0,10,0,0"
                      IsVisible="False">
                <TextBlock x:Name="ProviderSwitchStatusText"
                           Text=""
                           Classes="muted"
                           FontSize="12"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
              </Border>
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  x:Name="ChatBackgroundHost"
                  CornerRadius="20"
                  Background="White"
                  BorderBrush="{StaticResource AemiBorderBrush}"
                  BorderThickness="1"
                  Margin="0,12,0,0">
            <Grid>
              <Border IsHitTestVisible="False" Margin="1" CornerRadius="19" BorderBrush="{StaticResource AemiBorderSoftBrush}" BorderThickness="1"/>
              <ScrollViewer x:Name="ChatScrollViewer"
                            Classes="chat-messages"
                            Padding="18"
                            HorizontalContentAlignment="Stretch"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            AutomationProperties.Name="&#x5BF9;&#x8BDD;&#x6D88;&#x606F;">
                <StackPanel x:Name="MessagesPanel"
                            HorizontalAlignment="Stretch"
                            Spacing="12"
                            Margin="0,0,0,54"/>
              </ScrollViewer>

              <StackPanel x:Name="EmptyStatePanel"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MaxWidth="520"
                          Spacing="12"
                          Margin="24">
                <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource AemiGlassSoftBrush}" BorderBrush="{StaticResource AemiPinkBrush}" BorderThickness="1.5" HorizontalAlignment="Center">
                  <Image Source="avares://Aemeath-agent/Assets/static/xiaoai-avatar.png" Stretch="UniformToFill" ClipToBounds="True"/>
                </Border>
                <TextBlock x:Name="EmptyStateTitle" Text="&#x542C;&#x5F97;&#x5230;&#x5417;&#xFF1F;" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock x:Name="EmptyStateText" Text="&#x4ECA;&#x5929;&#x60F3;&#x804A;&#x4EC0;&#x4E48;&#xFF1F;&#x4E5F;&#x53EF;&#x4EE5;&#x628A;&#x56FE;&#x7247;&#x6216;&#x6587;&#x4EF6;&#x4EA4;&#x7ED9;&#x6211;&#x3002;" Classes="subtle" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21"/>
                <WrapPanel HorizontalAlignment="Center">
                  <Button x:Name="PromptIntroButton" Content="&#x4ECB;&#x7ECD;&#x4E00;&#x4E0B;&#x4F60;&#x81EA;&#x5DF1;" Classes="ghost" Margin="4"/>
                  <Button x:Name="PromptPlanButton" Content="&#x5E2E;&#x6211;&#x6574;&#x7406;&#x4ECA;&#x5929;&#x7684;&#x8BA1;&#x5212;" Classes="ghost" Margin="4"/>
                  <Button x:Name="PromptImageButton" Content="&#x770B;&#x770B;&#x6211;&#x7684;&#x56FE;&#x7247;" Classes="ghost" Margin="4"/>
                </WrapPanel>
                <Button x:Name="EmptyStateActionButton" Content="&#x5F00;&#x59CB;&#x5BF9;&#x8BDD;" Classes="primary" HorizontalAlignment="Center" MinWidth="132"/>
              </StackPanel>

              <Button x:Name="JumpToLatestButton"
                      Content="&#x56DE;&#x5230;&#x6700;&#x65B0;"
                      Classes="ghost"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,16,14"
                      IsVisible="False"
                      AutomationProperties.Name="&#x6EDA;&#x52A8;&#x5230;&#x6700;&#x65B0;&#x6D88;&#x606F;"/>
            </Grid>
          </Border>

          <Border Grid.Row="2" Classes="card" Padding="12" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,Auto">
              <WrapPanel x:Name="AttachmentPanel" IsVisible="False" Margin="0,0,0,10"/>
              <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button x:Name="UploadButton" Classes="icon ghost" Width="50" Height="50" AutomationProperties.Name="&#x6DFB;&#x52A0;&#x56FE;&#x7247;&#x6216;&#x6587;&#x4EF6;"/>
                <Button Grid.Column="1" x:Name="McpToolsButton" Classes="icon ghost" Width="50" Height="50" Margin="8,0,0,0" AutomationProperties.Name="MCP &#x5DE5;&#x5177;"/>
                <TextBox Grid.Column="2"
                         x:Name="InputBox"
                         PlaceholderText="&#x5411;&#x5C0F;&#x7231;&#x53D1;&#x9001;&#x6D88;&#x606F;..."
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         TextChanged="InputBox_OnTextChanged"
                         i:InputMethod.IsInputMethodEnabled="True"
                         Margin="8,0,0,0"
                         MinHeight="50"
                         MaxHeight="126"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="&#x6D88;&#x606F;&#x8F93;&#x5165;&#x6846;"/>
                <Button Grid.Column="2"
                        x:Name="VoiceRecordButton"
                        IsVisible="False"
                        MinHeight="50"
                        Height="50"
                        HorizontalAlignment="Stretch"
                        Margin="8,0,0,0"
                        Classes="ghost voice-record"
                        FontSize="15"
                        FontWeight="SemiBold"
                        AutomationProperties.Name="&#x5F00;&#x59CB;&#x5F55;&#x97F3;">
                  <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center">
                    <Grid Width="26" Height="26" VerticalAlignment="Center">
                      <Ellipse x:Name="VoicePulseRing"
                               Classes="voice-pulse"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="False"
                               IsHitTestVisible="False"
                               RenderTransformOrigin="50%,50%"/>
                      <Ellipse x:Name="VoiceStatusDot"
                               Classes="voice-dot"
                               Width="9"
                               Height="9"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock Grid.Column="1"
                               x:Name="VoiceRecordButtonText"
                               Text="&#x5F00;&#x59CB;&#x5F55;&#x97F3;"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                  </Grid>
                </Button>
                <Button Grid.Column="3" x:Name="VoiceButton" Classes="icon ghost" Width="50" Height="50" Margin="8,0,0,0" AutomationProperties.Name="&#x5207;&#x6362;&#x8BED;&#x97F3;&#x8F93;&#x5165;"/>
                <Button Grid.Column="4" x:Name="SendButton" Content="&#x53D1;&#x9001;" Classes="primary" MinWidth="100" Height="50" Margin="8,0,0,0" AutomationProperties.Name="&#x53D1;&#x9001;&#x6D88;&#x606F;"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </SplitView.Content>
    </SplitView>
  </Grid>
</Window>
