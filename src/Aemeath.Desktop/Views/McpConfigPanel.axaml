<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aemeath.Desktop.Views.McpConfigPanel"
             Background="Transparent">

  <Grid RowDefinitions="Auto,*">

    <!-- 顶部工具栏 -->
    <Border Grid.Row="0" CornerRadius="14" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1" Background="#FFFFFF" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto">
        <!-- 左：标题 + 计数 + 整体状态 -->
        <StackPanel Grid.Column="0" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="MCP 服务" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="" Classes="muted" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="OverallStatusText" Text="未加载" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- 右：操作按钮组 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="DownloadMcpDependenciesButton" Content="环境依赖" Classes="ghost" MinWidth="92" ToolTip.Tip="检测/下载 uv.exe、bun.exe 运行依赖"/>
          <Button x:Name="RefreshMcpButton" Content="重新加载" Classes="ghost" MinWidth="92"/>
          <Button x:Name="AddButton" Content="+ 添加" Classes="primary" MinWidth="86"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 左右分栏：左列表 + 右详情 -->
    <Grid Grid.Row="1" ColumnDefinitions="300,*" Margin="0,12,0,0" MinHeight="0">

      <!-- 左：服务列表 -->
      <Border Grid.Column="0" CornerRadius="14" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1" Background="#FFFFFF" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="服务列表" Classes="subtle" Margin="4,0,0,6"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ServerCardsPanel" Spacing="6"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- 右：选中服务详情 / 空状态 -->
      <Border Grid.Column="1" CornerRadius="14" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1" Background="#FFFFFF" Padding="14" Margin="12,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <!-- 依赖状态（紧凑） -->
            <TextBlock x:Name="McpDependencyStatusText" Text="" Classes="muted" TextWrapping="Wrap" IsVisible="False"/>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyHintPanel" Spacing="6" IsVisible="True">
              <TextBlock Text="未选择服务" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}"/>
              <TextBlock Text="点击左侧选择一个服务编辑，或点右上「+ 添加」创建新的 MCP 服务。" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 编辑表单 -->
            <StackPanel x:Name="EditFormPanel" Spacing="10" IsVisible="False">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="服务详情" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" x:Name="EnabledBox" Content="启用"/>
              </Grid>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="4">
                  <TextBlock Text="服务 ID" Classes="subtle"/>
                  <TextBox x:Name="ServerIdBox" PlaceholderText="filesystem"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                  <TextBlock Text="显示名称" Classes="subtle"/>
                  <TextBox x:Name="ServerNameBox" PlaceholderText="文件系统"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="4">
                  <TextBlock Text="连接方式" Classes="subtle"/>
                  <ComboBox x:Name="TransportBox" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                  <TextBlock Text="URL（HTTP）" Classes="subtle"/>
                  <TextBox x:Name="UrlBox" PlaceholderText="https://example.com/mcp"/>
                </StackPanel>
              </Grid>
              <StackPanel Spacing="4">
                <TextBlock Text="命令 Command（stdio）" Classes="subtle"/>
                <TextBox x:Name="CommandBox" PlaceholderText="bun / uvx / npx / 可执行文件路径"/>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="参数 Args（每行一个）" Classes="subtle"/>
                <TextBox x:Name="ArgsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="工作目录（stdio，可空）" Classes="subtle"/>
                <TextBox x:Name="WorkingDirectoryBox" PlaceholderText="C:\path\to\project"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="4">
                  <TextBlock Text="环境变量（KEY=VALUE）" Classes="subtle"/>
                  <TextBox x:Name="EnvBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                  <TextBlock Text="请求头 Headers（KEY=VALUE）" Classes="subtle"/>
                  <TextBox x:Name="HeadersBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                </StackPanel>
              </Grid>
              <WrapPanel>
                <Button x:Name="SaveButton" Content="保存" Classes="primary" MinWidth="92" Margin="0,0,8,0"/>
                <Button x:Name="TestButton" Content="测试连接" Classes="ghost" MinWidth="92" Margin="0,0,8,0"/>
                <Button x:Name="DeleteButton" Content="删除" Classes="danger" MinWidth="92"/>
              </WrapPanel>
              <TextBlock x:Name="StatusText" Text="" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
