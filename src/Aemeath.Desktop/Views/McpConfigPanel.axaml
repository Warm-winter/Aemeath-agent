<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aemeath.Desktop.Views.McpConfigPanel"
             Background="Transparent">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="card" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="MCP 服务" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="CountText" Classes="muted" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="OverallStatusText" Text="未加载" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="ActionStatusText" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button x:Name="DownloadMcpDependenciesButton" Content="环境依赖" Classes="ghost" MinWidth="92" Margin="0,0,8,8" ToolTip.Tip="检测或下载 uv.exe、bun.exe"/>
          <Button x:Name="RefreshMcpButton" Content="重新加载" Classes="ghost" MinWidth="92" Margin="0,0,8,8"/>
          <Button x:Name="AddButton" Content="添加" Classes="primary" MinWidth="86" Margin="0,0,0,8"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Grid x:Name="McpLayoutGrid" Grid.Row="1" ColumnDefinitions="288,*" RowDefinitions="*" Margin="0,12,0,0" MinHeight="0">
      <Border x:Name="ServerListPane" Classes="card" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="服务列表" Classes="subtle" Margin="4,0,0,7"/>
          <ListBox Grid.Row="1" x:Name="ServerListBox" AutomationProperties.Name="MCP 服务列表"/>
        </Grid>
      </Border>

      <Border x:Name="ServerEditorPane" Grid.Column="1" Classes="card" Padding="14" Margin="12,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <TextBlock x:Name="McpDependencyStatusText" Classes="muted" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Polite"/>

            <StackPanel x:Name="EmptyHintPanel" Spacing="6" IsVisible="True">
              <TextBlock Text="未选择服务" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="从左侧选择服务，或使用“添加”创建和导入 MCP 配置。" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="EditFormPanel" Spacing="11" IsVisible="False">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="服务详情" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DirtyText" Text="有未保存更改" Foreground="{StaticResource AemiWarningBrush}" IsVisible="False"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="EnabledBox" Content="启用" VerticalAlignment="Center"/>
              </Grid>

              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="5">
                  <TextBlock Text="服务 ID" Classes="subtle"/>
                  <TextBox x:Name="ServerIdBox" PlaceholderText="filesystem" AutomationProperties.Name="MCP 服务 ID"/>
                  <TextBlock x:Name="ServerIdErrorText" Foreground="{StaticResource AemiErrorBrush}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                  <TextBlock Text="显示名称" Classes="subtle"/>
                  <TextBox x:Name="ServerNameBox" PlaceholderText="文件系统" AutomationProperties.Name="MCP 服务显示名称"/>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="5">
                <TextBlock Text="连接方式" Classes="subtle"/>
                <ComboBox x:Name="TransportBox" HorizontalAlignment="Stretch" AutomationProperties.Name="MCP 连接方式"/>
              </StackPanel>

              <Border x:Name="StdioFieldsPanel" Classes="card" Background="{StaticResource AemiPanelSoftBrush}" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="本地命令（stdio）" FontWeight="SemiBold"/>
                  <TextBlock Text="命令" Classes="subtle"/>
                  <TextBox x:Name="CommandBox" PlaceholderText="bun / uvx / npx / 可执行文件路径" AutomationProperties.Name="stdio 命令"/>
                  <TextBlock x:Name="CommandErrorText" Foreground="{StaticResource AemiErrorBrush}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                  <TextBlock Text="参数（每行一个）" Classes="subtle"/>
                  <TextBox x:Name="ArgsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="stdio 参数"/>
                  <TextBlock Text="工作目录（可空）" Classes="subtle"/>
                  <TextBox x:Name="WorkingDirectoryBox" PlaceholderText="C:\path\to\project" AutomationProperties.Name="stdio 工作目录"/>
                </StackPanel>
              </Border>

              <Border x:Name="HttpFieldsPanel" Classes="card" Background="{StaticResource AemiPanelSoftBrush}" Padding="12" IsVisible="False">
                <StackPanel Spacing="8">
                  <TextBlock Text="HTTP 服务" FontWeight="SemiBold"/>
                  <TextBlock Text="URL" Classes="subtle"/>
                  <TextBox x:Name="UrlBox" PlaceholderText="https://example.com/mcp" AutomationProperties.Name="MCP HTTP URL"/>
                  <TextBlock x:Name="UrlErrorText" Foreground="{StaticResource AemiErrorBrush}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
              </Border>

              <Expander Header="高级设置" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,10,0,0">
                  <StackPanel x:Name="EnvFieldsPanel" Spacing="5">
                    <TextBlock Text="环境变量（KEY=VALUE，每行一个）" Classes="subtle"/>
                    <TextBox x:Name="EnvBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="MCP 环境变量"/>
                    <TextBlock x:Name="EnvErrorText" Foreground="{StaticResource AemiErrorBrush}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                  </StackPanel>
                  <StackPanel x:Name="HeaderFieldsPanel" Spacing="5" IsVisible="False">
                    <TextBlock Text="请求头（KEY=VALUE，每行一个）" Classes="subtle"/>
                    <TextBox x:Name="HeadersBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="MCP HTTP 请求头"/>
                    <TextBlock x:Name="HeadersErrorText" Foreground="{StaticResource AemiErrorBrush}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                  </StackPanel>
                </StackPanel>
              </Expander>

              <ProgressBar x:Name="BusyProgress" Height="4" IsIndeterminate="True" IsVisible="False" AutomationProperties.Name="MCP 操作进度"/>
              <WrapPanel>
                <Button x:Name="SaveButton" Content="保存更改" Classes="primary" MinWidth="104" Margin="0,0,8,8"/>
                <Button x:Name="CancelChangesButton" Content="取消更改" Classes="ghost" MinWidth="104" Margin="0,0,8,8" IsEnabled="False"/>
                <Button x:Name="TestButton" Content="测试连接" Classes="ghost" MinWidth="104" Margin="0,0,8,8"/>
                <Button x:Name="DeleteButton" Content="删除服务" Classes="danger" MinWidth="104" Margin="0,0,0,8"/>
              </WrapPanel>
              <TextBlock x:Name="StatusText" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
