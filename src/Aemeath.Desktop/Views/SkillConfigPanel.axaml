<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aemeath.Desktop.Views.SkillConfigPanel"
             Background="Transparent">

  <Grid RowDefinitions="Auto,*">

    <!-- 顶部工具栏 -->
    <Border Grid.Row="0" CornerRadius="14" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1" Background="#FFFFFF" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Skill 管理" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="" Classes="muted" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Skill 提供人格定义与背景知识库。内置 skill 随程序分发、不可删除。" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="ReloadButton" Content="重新加载" Classes="ghost" MinWidth="92" ToolTip.Tip="重新加载所有 skill 并刷新 AI 人格"/>
          <Button x:Name="AddButton" Content="+ 导入" Classes="primary" MinWidth="86" ToolTip.Tip="从文件夹导入用户 skill"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 左右分栏 -->
    <Grid Grid.Row="1" ColumnDefinitions="300,*" Margin="0,12,0,0" MinHeight="0">

      <!-- 左：skill 列表 -->
      <Border Grid.Column="0" CornerRadius="14" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1" Background="#FFFFFF" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Skill 列表" Classes="subtle" Margin="4,0,0,6"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SkillCardsPanel" Spacing="6"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- 右：详情 / 空状态 -->
      <Border Grid.Column="1" CornerRadius="14" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1" Background="#FFFFFF" Padding="14" Margin="12,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <!-- 空状态 -->
            <StackPanel x:Name="EmptyHintPanel" Spacing="6" IsVisible="True">
              <TextBlock Text="未选择 Skill" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}"/>
              <TextBlock Text="点击左侧选择一个 skill 查看详情，或点右上「+ 导入」从文件夹导入新的 skill。" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 详情 -->
            <StackPanel x:Name="DetailPanel" Spacing="10" IsVisible="False">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock x:Name="NameText" Text="" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border x:Name="SourceBadge" CornerRadius="999" Padding="8,2">
                      <TextBlock x:Name="SourceText" Text="" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="EnabledBadge" CornerRadius="999" Padding="8,2">
                      <TextBlock x:Name="EnabledText" Text="" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="触发词" Classes="subtle"/>
                <TextBlock x:Name="TriggersText" Text="" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="简介" Classes="subtle"/>
                <TextBlock x:Name="DescText" Text="" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="提供的能力" Classes="subtle"/>
                <TextBlock x:Name="CapabilitiesText" Text="" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="4" x:Name="DirectoryPanel">
                <TextBlock Text="目录路径" Classes="subtle"/>
                <TextBlock x:Name="DirectoryText" Text="" TextWrapping="Wrap" FontFamily="Cascadia Code,Consolas,Courier New" FontSize="12"/>
              </StackPanel>

              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="ToggleEnabledButton" Content="停用" Classes="ghost" MinWidth="92" Margin="0,0,8,0"/>
                <Button x:Name="DeleteButton" Content="删除" Classes="danger" MinWidth="92"/>
              </WrapPanel>
              <TextBlock x:Name="NoteText" Text="" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock x:Name="StatusText" Text="" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
