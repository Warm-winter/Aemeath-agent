<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aemeath.Desktop.Views.SkillConfigPanel"
             Background="Transparent">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="card" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Skill 管理" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="CountText" Classes="muted" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Skill 提供人格与知识库。内置 Skill 随程序分发并保持锁定。" Classes="muted" TextWrapping="Wrap"/>
          <TextBlock x:Name="ActionStatusText" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="ReloadButton" Content="重新加载" Classes="ghost" MinWidth="92" Margin="0,0,8,8"/>
          <Button x:Name="AddButton" Content="导入" Classes="primary" MinWidth="86" Margin="0,0,0,8"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Grid x:Name="SkillLayoutGrid" Grid.Row="1" ColumnDefinitions="288,*" RowDefinitions="*" Margin="0,12,0,0" MinHeight="0">
      <Border x:Name="SkillListPane" Classes="card" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Skill 列表" Classes="subtle" Margin="4,0,0,7"/>
          <ListBox Grid.Row="1" x:Name="SkillListBox" AutomationProperties.Name="Skill 列表"/>
        </Grid>
      </Border>

      <Border x:Name="SkillDetailPane" Grid.Column="1" Classes="card" Padding="14" Margin="12,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="11">
            <StackPanel x:Name="EmptyHintPanel" Spacing="6" IsVisible="True">
              <TextBlock Text="未选择 Skill" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="使用键盘或鼠标从左侧选择 Skill，或导入包含 SKILL.md 的文件夹。" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="DetailPanel" Spacing="11" IsVisible="False">
              <StackPanel Spacing="4">
                <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold"/>
                <WrapPanel>
                  <Border x:Name="SourceBadge" CornerRadius="999" Padding="8,2" Margin="0,0,6,0"><TextBlock x:Name="SourceText" FontSize="11" FontWeight="SemiBold"/></Border>
                  <Border x:Name="EnabledBadge" CornerRadius="999" Padding="8,2"><TextBlock x:Name="EnabledText" FontSize="11" FontWeight="SemiBold"/></Border>
                </WrapPanel>
              </StackPanel>

              <Border x:Name="BuiltinLockPanel" Classes="status" IsVisible="False">
                <TextBlock Text="内置 Skill 已锁定：始终启用，不能删除或停用。" TextWrapping="Wrap" Foreground="{StaticResource AemiIconBrush}"/>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Text="触发词" Classes="subtle"/>
                <TextBlock x:Name="TriggersText" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="简介" Classes="subtle"/>
                <TextBlock x:Name="DescText" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="提供的能力" Classes="subtle"/>
                <TextBlock x:Name="CapabilitiesText" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="4" x:Name="DirectoryPanel">
                <TextBlock Text="目录路径" Classes="subtle"/>
                <TextBox x:Name="DirectoryText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Code,Consolas,Courier New" FontSize="12" AutomationProperties.Name="Skill 目录路径"/>
              </StackPanel>

              <WrapPanel Margin="0,6,0,0">
                <Button x:Name="ToggleEnabledButton" Content="停用" Classes="ghost" MinWidth="92" Margin="0,0,8,8"/>
                <Button x:Name="DeleteButton" Content="删除 Skill" Classes="danger" MinWidth="104" Margin="0,0,0,8"/>
              </WrapPanel>
              <TextBlock x:Name="NoteText" Classes="muted" TextWrapping="Wrap"/>
              <ProgressBar x:Name="BusyProgress" Height="4" IsIndeterminate="True" IsVisible="False" AutomationProperties.Name="Skill 操作进度"/>
              <TextBlock x:Name="StatusText" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
