<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:Aemeath.Pet.Effects;assembly=Aemeath.Pet"
        xmlns:views="clr-namespace:Aemeath.Desktop.Views"
        x:Class="Aemeath.Desktop.Views.ConfigWindow"
        x:CompileBindings="False"
        Width="1100" Height="800"
        MinWidth="720" MinHeight="640"
        Title="设置中心"
        WindowDecorations="BorderOnly"
        Icon="avares://Aemeath-agent/Assets/static/app.ico">
  <Window.Styles>
    <Style Selector="ListBox#SettingsTabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox#SettingsTabControl ListBoxItem">
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{StaticResource AemiTextSecondaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="11"/>
    </Style>
    <Style Selector="ListBox#SettingsTabControl ListBoxItem:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AemiTextPrimaryBrush}"/>
      <Setter Property="Background" Value="{StaticResource AemiPanelSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AemiBorderSoftBrush}"/>
    </Style>
    <Style Selector="ListBox#SettingsTabControl ListBoxItem:selected">
      <Setter Property="Foreground" Value="{StaticResource AemiTextPrimaryBrush}"/>
      <Setter Property="Background" Value="{StaticResource AemiPinkSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AemiBorderStrongBrush}"/>
    </Style>
    <Style Selector="ListBox#SettingsTabControl ListBoxItem:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource AemiFocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="ListBox#SettingsTabControl ListBoxItem.group-heading">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="4,10,4,4"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource AemiTextMutedBrush}"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Grid x:Name="BackgroundContainer" Grid.RowSpan="2" IsHitTestVisible="False" Background="{StaticResource AemiWindowBackgroundBrush}">
      <effects:ParticleField x:Name="BackgroundParticleCanvas" Opacity="0.24"/>
      <Border x:Name="GlowLayerPink" IsHitTestVisible="False" Background="{StaticResource AemiGlowPinkBrush}"/>
      <Border x:Name="GlowLayerBlue" IsHitTestVisible="False" Background="{StaticResource AemiGlowHaloBrush}"/>
      <Border x:Name="GlowLayerWhite" IsHitTestVisible="False" Opacity="0.48" Background="{StaticResource AemiGlowWhiteBrush}"/>
    </Grid>

    <views:AemeathTitleBar Grid.Row="0" Title="&#x7231;&#x5F25;&#x65AF;&#x52A9;&#x624B; &#x00B7; &#x8BBE;&#x7F6E;&#x4E2D;&#x5FC3;"/>

    <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,*">
      <Border Grid.Row="0" CornerRadius="18" Background="{StaticResource AemiGlassBrush}" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1" Padding="14">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="54" Height="54" CornerRadius="27" Background="White" BorderBrush="{StaticResource AemiStarBrush}" BorderThickness="1.5">
            <Image Source="avares://Aemeath-agent/Assets/static/app.ico" Stretch="Uniform" Margin="9"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="爱弥斯设置中心" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AemiTextPrimaryBrush}"/>
              <Border CornerRadius="999" Padding="8,3" Background="{StaticResource AemiPinkSoftBrush}" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1">
                <TextBlock Text="Startorch Archive" FontSize="12" Foreground="{StaticResource AemiIconBrush}" FontWeight="SemiBold"/>
              </Border>
            </StackPanel>
            <TextBlock Text="管理连接、能力与个性化；简单偏好自动保存，服务配置由你确认后再写入。" Classes="subtle" FontSize="13" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" CornerRadius="20" Background="{StaticResource AemiGlassBrush}" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1" Margin="0,12,0,0" Padding="10">
        <Grid x:Name="SettingsShellGrid" ColumnDefinitions="176,*" MinHeight="0">
          <Border Grid.Column="0" Background="{StaticResource AemiPanelSoftBrush}" BorderBrush="{StaticResource AemiBorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="9">
            <ListBox x:Name="SettingsTabControl" SelectionMode="Single" AutomationProperties.Name="设置页面导航">
              <ListBoxItem x:Name="ConnectionGroupItem" Classes="group-heading" IsEnabled="False" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="连接分组">
                <TextBlock Text="连接" FontSize="11" FontWeight="SemiBold"/>
              </ListBoxItem>
              <ListBoxItem x:Name="ProviderNavigationItem" IsSelected="True">
                <ListBoxItem.Content><TextBlock Text="AI 服务" FontWeight="SemiBold"/></ListBoxItem.Content>
                <ListBoxItem.Tag>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="ProviderLayoutGrid" ColumnDefinitions="270,*" RowDefinitions="Auto" Margin="2">
                      <Border x:Name="ProviderListPane" Classes="card" Padding="14">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" MinHeight="0">
                          <TextBlock Grid.Row="0" Text="已保存提供商" Classes="heading" FontSize="18"/>
                          <TextBlock Grid.Row="1" Text="选择一个连接进行编辑，切换前会保护未保存内容。" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                          <Button Grid.Row="2" x:Name="NewProviderButton" Content="新增提供商" Classes="ghost" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
                          <ScrollViewer x:Name="ProviderCardsScrollViewer" Grid.Row="3" MaxHeight="500" MinHeight="180" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ProviderCardsPanel" Spacing="10"/>
                          </ScrollViewer>
                        </Grid>
                      </Border>

                      <Border x:Name="ProviderEditorPane" Grid.Column="1" Classes="card" Padding="16" Margin="14,0,0,0">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                              <TextBlock Text="连接与模型" Classes="heading"/>
                              <TextBlock x:Name="ProviderDirtyText" Text="有未保存更改" Foreground="{StaticResource AemiWarningBrush}" IsVisible="False"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ToggleApiKeyButton" Content="显示密钥" Classes="ghost" MinWidth="88" AutomationProperties.Name="显示或隐藏 API Key"/>
                          </Grid>
                          <Border Classes="status">
                            <TextBlock x:Name="ProviderStatusText" Text="选择或新增一个提供商" Classes="subtle" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                          </Border>
                          <ProgressBar x:Name="ProviderBusyProgress" Height="4" IsIndeterminate="True" IsVisible="False" AutomationProperties.Name="提供商操作进度"/>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="6">
                              <TextBlock Text="Provider 预设" Classes="subtle"/>
                              <ComboBox x:Name="ProviderPresetBox" PlaceholderText="选择预设（可选）" AutomationProperties.Name="Provider 预设"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                              <TextBlock Text="提供商名称" Classes="subtle"/>
                              <TextBox x:Name="ProviderNameBox" PlaceholderText="openai / deepseek / custom" AutomationProperties.Name="提供商名称"/>
                              <TextBlock x:Name="ProviderNameErrorText" Foreground="{StaticResource AemiErrorBrush}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                          </Grid>

                          <TextBlock Text="API Key" Classes="subtle"/>
                          <TextBox x:Name="ApiKeyBox" PasswordChar="●" AutomationProperties.Name="API Key"/>

                          <TextBlock Text="OpenAI 兼容 URL" Classes="subtle"/>
                          <TextBox x:Name="EndpointBox" PlaceholderText="https://api.openai.com/v1" AutomationProperties.Name="OpenAI 兼容 URL"/>
                          <TextBlock x:Name="EndpointErrorText" Foreground="{StaticResource AemiErrorBrush}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>

                          <TextBlock Text="默认模型（仅列出已启用模型）" Classes="subtle"/>
                          <ComboBox x:Name="DefaultModelBox" AutomationProperties.Name="默认模型"/>
                          <TextBlock x:Name="DefaultModelErrorText" Foreground="{StaticResource AemiErrorBrush}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>

                          <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="ManualModelBox" PlaceholderText="手动添加模型 ID" AutomationProperties.Name="手动添加模型 ID"/>
                            <Button Grid.Column="1" x:Name="AddManualModelButton" Content="添加" Classes="ghost" Margin="8,0,0,0"/>
                          </Grid>
                          <Border Classes="card" Padding="10" MinHeight="130">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                              <StackPanel x:Name="ModelsPanel" Spacing="6"/>
                            </ScrollViewer>
                          </Border>
                          <WrapPanel>
                            <Button x:Name="SaveProviderButton" Content="保存更改" Classes="primary" MinWidth="112" Margin="0,0,8,8"/>
                            <Button x:Name="CancelProviderButton" Content="取消更改" Classes="ghost" MinWidth="104" Margin="0,0,8,8" IsEnabled="False"/>
                            <Button x:Name="TestProviderButton" Content="测试连接" Classes="ghost" MinWidth="104" Margin="0,0,8,8"/>
                            <Button x:Name="FetchModelsButton" Content="获取模型" Classes="ghost" MinWidth="104" Margin="0,0,8,8"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </ScrollViewer>
                </ListBoxItem.Tag>
              </ListBoxItem>

              <ListBoxItem x:Name="CapabilityGroupItem" Classes="group-heading" IsEnabled="False" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="能力分组">
                <TextBlock Text="能力" FontSize="11" FontWeight="SemiBold"/>
              </ListBoxItem>
              <ListBoxItem x:Name="MemoryNavigationItem">
                <ListBoxItem.Content><TextBlock Text="记忆" FontWeight="SemiBold"/></ListBoxItem.Content>
                <ListBoxItem.Tag>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="MemoryLayoutGrid" ColumnDefinitions="360,*" RowDefinitions="Auto" Margin="2">
                      <Border x:Name="MemoryListPane" Classes="card" Padding="14">
                        <StackPanel Spacing="11">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Text="长期记忆" Classes="heading"/>
                              <TextBlock Text="全局与当前会话的 Mem0 记忆" Classes="muted" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="RefreshMemoryButton" Content="刷新" Classes="ghost" MinWidth="72"/>
                          </Grid>
                          <Border Classes="card" Background="{StaticResource AemiPanelSoftBrush}" Padding="12">
                            <StackPanel Spacing="7">
                              <TextBlock Text="Mem0 运行环境" FontWeight="SemiBold"/>
                              <TextBlock x:Name="Mem0InstallStatusText" Text="正在检测…" TextWrapping="Wrap" Classes="subtle" AutomationProperties.LiveSetting="Polite"/>
                              <Button x:Name="Mem0InstallButton" Content="安装 Mem0 依赖" Classes="primary" HorizontalAlignment="Left" MinWidth="160"/>
                            </StackPanel>
                          </Border>
                          <Grid ColumnDefinitions="*,132">
                            <TextBox x:Name="MemorySearchBox" PlaceholderText="搜索记忆内容" AutomationProperties.Name="搜索长期记忆"/>
                            <ComboBox Grid.Column="1" x:Name="MemoryScopeBox" Margin="8,0,0,0" SelectedIndex="0" AutomationProperties.Name="记忆范围筛选">
                              <ComboBoxItem Content="全部范围" Tag="all"/>
                              <ComboBoxItem Content="全局" Tag="全局"/>
                              <ComboBoxItem Content="当前会话" Tag="会话"/>
                            </ComboBox>
                          </Grid>
                          <TextBlock x:Name="MemoryStatusText" Text="本地记忆仅保存在这台电脑" Classes="subtle" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                          <ListBox x:Name="MemoryListBox" MinHeight="300" MaxHeight="430" AutomationProperties.Name="长期记忆列表"/>
                          <WrapPanel>
                            <Button x:Name="DeleteMemoryButton" Content="删除选中" Classes="danger" MinWidth="104" Margin="0,0,8,8" IsEnabled="False"/>
                            <Button x:Name="ClearCurrentSessionMemoryButton" Content="清空当前会话" Classes="danger" MinWidth="128" Margin="0,0,8,8"/>
                            <Button x:Name="ClearAllMemoryButton" Content="清空全部" Classes="danger" MinWidth="104" Margin="0,0,8,8"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>

                      <Border x:Name="MemoryDetailPane" Grid.Column="1" Classes="card" Padding="16" Margin="14,0,0,0">
                        <StackPanel Spacing="12">
                          <TextBlock Text="记忆详情" Classes="heading"/>
                          <TextBlock Text="选择一条记忆后可查看完整内容。删除与清空操作都会再次确认。" Classes="subtle" TextWrapping="Wrap"/>
                          <Border Classes="card" Background="{StaticResource AemiPanelSoftBrush}" Padding="12">
                            <StackPanel Spacing="8">
                              <TextBlock x:Name="MemoryDetailScopeText" Text="尚未选择" Classes="muted"/>
                              <TextBox x:Name="MemoryDetailText" Text="从左侧选择一条记忆。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" AutomationProperties.Name="记忆完整内容"/>
                            </StackPanel>
                          </Border>
                          <TextBlock Text="爱弥斯会在相关对话前检索记忆。全局记忆跨会话生效；会话记忆只属于当前对话。" Classes="subtle" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </ScrollViewer>
                </ListBoxItem.Tag>
              </ListBoxItem>

              <ListBoxItem x:Name="ComputerControlNavigationItem">
                <ListBoxItem.Content><TextBlock Text="电脑控制" FontWeight="SemiBold"/></ListBoxItem.Content>
                <ListBoxItem.Tag>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="ComputerControlLayoutGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="2">
                      <Border x:Name="ComputerControlMainPane" Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                          <TextBlock Text="电脑控制" Classes="heading"/>
                          <TextBlock Text="所有真实操作仍会先显示确认卡。视觉模型是识别界面的必填依赖。" TextWrapping="Wrap" Classes="subtle"/>
                          <TextBlock Text="控制后端" Classes="subtle"/>
                          <ComboBox x:Name="ComputerControlBackendBox" AutomationProperties.Name="电脑控制后端">
                            <ComboBoxItem Content="自动选择（优先 UI Automation）" Tag="auto"/>
                            <ComboBoxItem Content="UI Automation（稳定、轻量）" Tag="uia"/>
                            <ComboBoxItem Content="UFO（复杂视觉任务）" Tag="ufo"/>
                          </ComboBox>
                          <Border Classes="card" Background="{StaticResource AemiPanelSoftBrush}" Padding="12">
                            <StackPanel Spacing="7">
                              <TextBlock Text="视觉模型" FontWeight="SemiBold"/>
                              <TextBlock Text="请选择已配置的视觉模型；必要时先回到 AI 服务页启用模型。" TextWrapping="Wrap" Classes="subtle"/>
                              <TextBlock Text="提供商" Classes="subtle"/>
                              <ComboBox x:Name="VisionProviderBox" PlaceholderText="复用当前对话提供商" AutomationProperties.Name="视觉模型提供商"/>
                              <TextBlock Text="模型（必填）" Classes="subtle"/>
                              <ComboBox x:Name="VisionModelBox" IsEditable="True" PlaceholderText="例如 gpt-4o-mini" AutomationProperties.Name="视觉模型"/>
                              <TextBlock x:Name="VisionModelErrorText" Foreground="{StaticResource AemiErrorBrush}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>

                      <Border x:Name="ComputerControlAdvancedPane" Grid.Column="1" Classes="card" Padding="16" Margin="14,0,0,0">
                        <StackPanel Spacing="12">
                          <TextBlock Text="高级设置" Classes="heading"/>
                          <TextBlock Text="只有选择 UFO 后端时才需要配置下列路径。检测不会自动保存。" Classes="subtle" TextWrapping="Wrap"/>
                          <Expander Header="UFO 运行环境" IsExpanded="False">
                            <StackPanel Spacing="8" Margin="0,10,0,0">
                              <TextBlock Text="UFO 专用 Python 解释器路径" Classes="subtle"/>
                              <TextBox x:Name="UfoPythonBox" PlaceholderText="…\Scripts\python.exe" AutomationProperties.Name="UFO Python 路径"/>
                              <TextBlock x:Name="UfoStatusText" Text="UFO 状态：未检测" TextWrapping="Wrap" Classes="subtle" AutomationProperties.LiveSetting="Polite"/>
                              <Button x:Name="UfoCheckButton" Content="检测 UFO 是否可用" Classes="ghost" HorizontalAlignment="Left" MinWidth="180"/>
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </Border>

                      <Border x:Name="ComputerControlActionsPane" Grid.Row="1" Grid.ColumnSpan="2" Classes="card" Padding="12" Margin="0,14,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ComputerControlDirtyText" Text="更改尚未保存" Foreground="{StaticResource AemiWarningBrush}" IsVisible="False"/>
                            <TextBlock x:Name="ComputerControlStatusText" Text="保存后新的电脑控制任务会使用此配置。" Classes="subtle" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CancelComputerControlButton" Content="取消更改" Classes="ghost" MinWidth="104" IsEnabled="False"/>
                            <Button x:Name="SaveComputerControlButton" Content="保存电脑控制" Classes="primary" MinWidth="132"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>
                  </ScrollViewer>
                </ListBoxItem.Tag>
              </ListBoxItem>

              <ListBoxItem x:Name="McpNavigationItem">
                <ListBoxItem.Content><TextBlock Text="MCP" FontWeight="SemiBold"/></ListBoxItem.Content>
                <ListBoxItem.Tag>
                  <Border Classes="card" Padding="14"><views:McpConfigPanel x:Name="McpPanel"/></Border>
                </ListBoxItem.Tag>
              </ListBoxItem>

              <ListBoxItem x:Name="SkillNavigationItem">
                <ListBoxItem.Content><TextBlock Text="Skill" FontWeight="SemiBold"/></ListBoxItem.Content>
                <ListBoxItem.Tag>
                  <Border Classes="card" Padding="14"><views:SkillConfigPanel x:Name="SkillPanel"/></Border>
                </ListBoxItem.Tag>
              </ListBoxItem>

              <ListBoxItem x:Name="PersonalizationGroupItem" Classes="group-heading" IsEnabled="False" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="个性化分组">
                <TextBlock Text="个性化" FontSize="11" FontWeight="SemiBold"/>
              </ListBoxItem>
              <ListBoxItem x:Name="PetNavigationItem">
                <ListBoxItem.Content><TextBlock Text="桌宠与界面" FontWeight="SemiBold"/></ListBoxItem.Content>
                <ListBoxItem.Tag>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                          <TextBlock Text="桌宠与界面" Classes="heading"/>
                          <TextBlock Text="这些偏好会立即保存。透明度在停止拖动约 250ms 后写入。" Classes="subtle" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="SimpleSettingsStatusText" Text="已同步" Foreground="{StaticResource AemiSuccessBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                      </Grid>
                      <Border Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                          <TextBlock Text="窗口行为" FontSize="18" FontWeight="SemiBold"/>
                          <CheckBox x:Name="AlwaysOnTopBox" Content="桌宠保持窗口最上层"/>
                          <CheckBox x:Name="MinimizeToTrayBox" Content="关闭时收纳到系统托盘"/>
                          <CheckBox x:Name="AutoStartBox" Content="开机自启动"/>
                        </StackPanel>
                      </Border>
                      <Border Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                          <TextBlock Text="动态效果" FontSize="18" FontWeight="SemiBold"/>
                          <CheckBox x:Name="ParticleEffectsBox" Content="开启背景粒子动效"/>
                          <CheckBox x:Name="ReduceMotionBox" Content="减少动态效果"/>
                          <TextBlock Text="减少动态效果会关闭粒子、平移与持续闪烁，只保留必要的短淡入。" Classes="subtle" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <Border Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                          <TextBlock Text="桌宠外观与互动" FontSize="18" FontWeight="SemiBold"/>
                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="7">
                              <TextBlock Text="尺寸档位" Classes="subtle"/>
                              <ComboBox x:Name="PetSizeBox" AutomationProperties.Name="桌宠尺寸档位"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="7" Margin="14,0,0,0">
                              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="透明度" Classes="subtle"/><TextBlock Grid.Column="1" x:Name="PetOpacityValueText" Classes="muted"/></Grid>
                              <Slider x:Name="PetOpacitySlider" Minimum="0.65" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="桌宠透明度"/>
                            </StackPanel>
                          </Grid>
                          <CheckBox x:Name="EnablePetBubblesBox" Content="开启桌宠气泡台词"/>
                          <CheckBox x:Name="EnablePetIdleGreetingBox" Content="开启闲置问候"/>
                          <CheckBox x:Name="EnablePetEdgeSnapBox" Content="开启边缘吸附"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </ListBoxItem.Tag>
              </ListBoxItem>

              <ListBoxItem x:Name="AppearanceNavigationItem">
                <ListBoxItem.Content><TextBlock Text="头像与背景" FontWeight="SemiBold"/></ListBoxItem.Content>
                <ListBoxItem.Tag>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="AppearanceLayoutGrid" ColumnDefinitions="*,*" RowDefinitions="Auto" Margin="2">
                      <Border x:Name="AvatarPane" Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                          <TextBlock Text="你的头像" Classes="heading"/>
                          <TextBlock Text="选择后立即保存，并用于新的对话消息。" Classes="subtle"/>
                          <Border Width="112" Height="112" CornerRadius="56" BorderBrush="{StaticResource AemiStarBrush}" BorderThickness="1.5" Background="White" HorizontalAlignment="Left">
                            <Image x:Name="AvatarPreviewImage" Stretch="UniformToFill" ClipToBounds="True"/>
                          </Border>
                          <RadioButton x:Name="AvatarMaleRadio" Content="男（默认）" GroupName="AvatarType"/>
                          <RadioButton x:Name="AvatarFemaleRadio" Content="女" GroupName="AvatarType"/>
                          <RadioButton x:Name="AvatarCustomRadio" Content="自定义头像" GroupName="AvatarType"/>
                          <Button x:Name="BrowseAvatarButton" Content="选择自定义头像" Classes="ghost" HorizontalAlignment="Left" MinWidth="150"/>
                        </StackPanel>
                      </Border>

                      <Border x:Name="ChatBackgroundPane" Grid.Column="1" Classes="card" Padding="16" Margin="14,0,0,0">
                        <StackPanel Spacing="12">
                          <TextBlock Text="聊天背景" Classes="heading"/>
                          <TextBlock Text="图片会裁剪并压缩为适合桌面显示的尺寸。" Classes="subtle" TextWrapping="Wrap"/>
                          <Border Height="190" CornerRadius="14" BorderBrush="{StaticResource AemiBorderBrush}" BorderThickness="1" Background="White">
                            <Image x:Name="ChatBackgroundPreviewImage" Stretch="UniformToFill" ClipToBounds="True"/>
                          </Border>
                          <WrapPanel>
                            <Button x:Name="BrowseChatBackgroundButton" Content="选择背景图" Classes="primary" MinWidth="120" Margin="0,0,8,8"/>
                            <Button x:Name="ClearChatBackgroundButton" Content="清除背景图" Classes="danger" MinWidth="120" Margin="0,0,8,8"/>
                          </WrapPanel>
                          <TextBlock x:Name="AppearanceStatusText" Text="更改会立即保存。" Classes="subtle" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </ScrollViewer>
                </ListBoxItem.Tag>
              </ListBoxItem>
            </ListBox>
          </Border>

          <TransitioningContentControl Grid.Column="1" x:Name="SettingsContentHost" Margin="10,0,0,0" ClipToBounds="True"
                                       Content="{Binding SelectedItem.Tag, ElementName=SettingsTabControl}">
            <TransitioningContentControl.PageTransition>
              <CompositePageTransition>
                <PageSlide Duration="0:0:0.22" Orientation="Horizontal"/>
                <CrossFade Duration="0:0:0.18"/>
              </CompositePageTransition>
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
